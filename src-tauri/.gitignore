# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Build/archive output under gen/ - regenerated by every `tauri ios build` /
# `tauri android build`, and large (compiled binaries, .ipa/.apk, dSYMs) -
# only the actual project config (project.yml, Info.plist, xcodeproj, gradle
# files) is worth tracking.
/gen/apple/build/
/gen/apple/Externals/
/gen/android/build/
/gen/android/app/build/
/gen/android/.gradle/
