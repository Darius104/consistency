{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Consistency",
  "version": "0.1.14",
  "identifier": "com.darius.consistency",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Consistency",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwQkRDRkQ5MDMyNzM0NzQKUldSME5DY0QyYys5SUtwQW5tMW1Cd3V1R1M3Yi9rRnFSY0VEZDhkT3htd1NGWHBGb0VJdVVKUVMK",
      "endpoints": [
        "https://github.com/Darius104/consistency/releases/latest/download/latest.json"
      ]
    }
  }
}
